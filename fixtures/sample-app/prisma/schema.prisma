datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?
  fullName  String
  dob       DateTime?
  gender    Gender?
  aadhaar   String?
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id         String @id @default(cuid())
  user       User   @relation(fields: [userId], references: [id])
  userId     String
  address    String
  pincode    String
  amount     Int
}
